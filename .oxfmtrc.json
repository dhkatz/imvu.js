{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "**/dist",
    "**/*.tsbuildinfo",
    "coverage",
    "**/coverage",
    "package-lock.json",
    "cookies.json",
    ".env",
    ".env.*",
    "docs",
    ".claude"
  ]
}
