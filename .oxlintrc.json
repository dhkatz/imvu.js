{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["**/dist/**", "coverage/**", "docs/**"],
  "rules": {
    "no-unused-vars": ["error", { "args": "none", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
    "typescript/no-explicit-any": "off",
    "no-undef": "off"
  }
}
