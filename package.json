{
  "name": "@imvu/monorepo",
  "version": "0.1.0",
  "author": "David Katz",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && npm run clean --workspaces",
    "lint": "tsc -b && oxlint --type-aware",
    "lint:fix": "tsc -b && oxlint --fix --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docs:build": "npm --prefix docs run build",
    "test": "vitest run",
    "test:typecheck": "tsc -p packages/rest/tsconfig.spec.json --noEmit && tsc -p packages/client/tsconfig.spec.json --noEmit && tsc -p packages/imq/tsconfig.spec.json --noEmit && tsc -p packages/xmlrpc/tsconfig.spec.json --noEmit && tsc -p packages/tools/tsconfig.spec.json --noEmit && tsc -p packages/cal3d/tsconfig.spec.json --noEmit && tsc -p packages/chkn/tsconfig.spec.json --noEmit && tsc -p packages/verify/tsconfig.spec.json --noEmit && tsc -p packages/bot/tsconfig.spec.json --noEmit && tsc -p examples/tsconfig.json",
    "test:watch": "vitest",
    "tool": "node --import tsx --env-file-if-exists=.env packages/tools/src/index.ts",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "docs:dev": "npm --prefix docs run dev",
    "docs:preview": "npm --prefix docs run preview",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "files": [
    "packages",
    "tsconfig.json",
    "tsconfig.base.json",
    "vitest.config.mts"
  ],
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsx": "^4.23.1",
    "typescript": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
