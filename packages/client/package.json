{
	"name": "@imvu/client",
	"version": "0.0.0",
	"description": "A JavaScript/TypeScript library for interacting with the IMVU web API.",
	"author": "dhkatz",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dhkatz/imvu.js.git",
		"directory": "packages/client"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -b",
		"clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
		"test": "vitest run"
	},
	"dependencies": {
		"@imvu/imq": "^0.0.0",
		"@imvu/rest": "^0.0.0",
		"@imvu/xmlrpc": "^0.0.0"
	},
	"homepage": "https://dhkatz.github.io/imvu.js/packages/client/",
	"bugs": {
		"url": "https://github.com/dhkatz/imvu.js/issues"
	},
	"engines": {
		"node": ">=22"
	}
}
