{
	"name": "@imvu/client",
	"version": "0.1.0",
	"description": "A JavaScript/TypeScript library for interacting with the IMVU web API.",
	"author": "dhkatz",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dhkatz/imvu.js.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -b",
		"clean": "rimraf ./dist",
		"lint": "eslint packages/client/src/**/* && tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@imvu/rest": "^0.1.0",
		"axios": "^1.18.0"
	},
	"devDependencies": {
		"axios-mock-adapter": "^1.21.5"
	}
}
