{
	"name": "@imvu/tools",
	"private": true,
	"version": "0.1.0",
	"description": "A JavaScript/TypeScript library for interacting with the IMVU web API.",
	"author": "dhkatz",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dhkatz/imvu.js.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -b",
		"clean": "rimraf ./dist",
		"test": "vitest run"
	},
	"dependencies": {
		"@imvu/client": "^0.1.0",
		"cli-progress": "^3.11.2",
		"commander": "^15.0.0",
		"image-type": "^6.1.0",
		"jszip": "^3.10.1",
		"lzma-purejs": "github:elderapo/lzma-purejs"
	}
}
