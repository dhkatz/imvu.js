{
	"name": "@imvu/chkn",
	"private": true,
	"version": "0.1.0",
	"description": "Read IMVU product packages: CFL/CHKN archives, index.xml templates with inheritance, and their Cal3D models.",
	"author": "dhkatz",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dhkatz/imvu.js.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -b",
		"clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
		"test": "vitest run"
	},
	"dependencies": {
		"@imvu/cal3d": "^0.1.0"
	}
}
