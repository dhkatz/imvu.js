{
	"name": "@imvu/bot",
	"version": "0.1.0",
	"description": "Build IMVU chat bots: commands, permissions, rate limiting and rejoining on top of @imvu/client.",
	"author": "dhkatz",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dhkatz/imvu.js.git",
		"directory": "packages/bot"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -b",
		"clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
		"test": "vitest run"
	},
	"dependencies": {
		"@imvu/client": "^0.1.0"
	},
	"homepage": "https://dhkatz.github.io/imvu.js/packages/bot/",
	"bugs": {
		"url": "https://github.com/dhkatz/imvu.js/issues"
	},
	"engines": {
		"node": ">=22"
	}
}
