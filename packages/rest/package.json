{
	"name": "@imvu/rest",
	"version": "0.1.0",
	"description": "Low-level IMVU REST client: auth, HTTP, cookie jar, and API types.",
	"author": "dhkatz",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dhkatz/imvu.js.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -b",
		"clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
		"test": "vitest run"
	},
	"dependencies": {
		"axios": "^1.18.0",
		"axios-cookiejar-support": "^7.0.0",
		"tough-cookie": "^6.0.0",
		"tough-cookie-file-store": "^3.3.0"
	}
}
